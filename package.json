{
  "name": "@missing-elements/pdfjs-viewer",
  "version": "4.5.0",
  "license": "MIT",
  "author": {
    "name": "Oleksandr Shevchuk",
    "email": "alekswebnet@gmail.com"
  },
  "keywords": [
    "javascript",
    "web-component",
    "typescript",
    "pdf-viewer",
    "pdf-document",
    "pdfjs",
    "react-pdf",
    "vue-pdf",
    "pdfjs-dist",
    "pdf-lib",
    "adobe-acrobat",
    "pdf-sdk",
    "embed-pdf",
    "pdfjs-viewer",
    "embed-pdf-viewer"
  ],
  "main": "./dist/pdfjs-viewer-element.js",
  "module": "./dist/pdfjs-viewer-element.js",
  "types": "types/pdfjs-viewer-element.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/pdfjs-viewer-element.d.ts",
      "default": "./dist/pdfjs-viewer-element.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/missing-elements/pdfjs-viewer.git"
  },
  "homepage": "https://missing-elements.github.io/pdfjs-viewer/",
  "bugs": {
    "url": "https://github.com/missing-elements/pdfjs-viewer/issues"
  },
  "files": [
    "dist",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync:pdfjs": "node scripts/sync-pdfjs-assets.mjs",
    "dev": "vite",
    "build": "pnpm sync:pdfjs && tsc && vite build && node scripts/copy-worker.mjs",
    "test": "pnpm sync:pdfjs && vitest",
    "coverage": "pnpm sync:pdfjs && vitest run --coverage",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  }
}
